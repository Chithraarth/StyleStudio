# Base URL path the app is served under. Use "/" for a standalone deploy.
BASE_PATH=/

# Clerk publishable key (from https://dashboard.clerk.com -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: Clerk proxy URL if you front Clerk through your own domain
# VITE_CLERK_PROXY_URL=

# Port for the local dev server
PORT=5173
