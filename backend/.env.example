# --- Required ---
# PostgreSQL connection string (any Postgres 15+ works, e.g. AWS RDS or Neon)
DATABASE_URL=postgresql://user:password@host:5432/style_studio

# Clerk authentication keys (from https://dashboard.clerk.com -> API Keys)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Port the API listens on
PORT=3001

# --- Object storage (look snapshots / photos) ---
# These come from Replit App Storage in the original environment.
# On AWS, point the storage client at your own bucket (see README).
PRIVATE_OBJECT_DIR=/your-bucket/.private
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public

# --- Optional ---
NODE_ENV=production
LOG_LEVEL=info
