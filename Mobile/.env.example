# No auth provider is wired up right now (Clerk was removed; Firebase is a
# planned follow-up) — the app sends no Authorization header, and the backend
# resolves every request to a single auto-provisioned default user.

# Host/domain where the backend API is reachable (no protocol), e.g. api.example.com
EXPO_PUBLIC_DOMAIN=localhost:3001

# Port for the Expo dev server
PORT=8081
