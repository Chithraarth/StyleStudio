# Clerk publishable key (from https://dashboard.clerk.com -> API Keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: Clerk proxy URL
# EXPO_PUBLIC_CLERK_PROXY_URL=

# Host/domain where the backend API is reachable (no protocol), e.g. api.example.com
EXPO_PUBLIC_DOMAIN=localhost:3001

# Port for the Expo dev server
PORT=8081
