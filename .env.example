# Copy to a real .env (or Portainer stack.env) on the server — never commit
# the filled-in version.

# Domain this stack serves (nginx + Let's Encrypt).
DOMAIN=cyberstyle.co

# Docker Hub account images are pushed to/pulled from.
DOCKERHUB_USER=

# Postgres
POSTGRES_PASSWORD=

# Clerk (backend) — placeholders until a real Clerk application exists.
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder

# Optional
LOG_LEVEL=info

# --- Build-time only (set as GitHub Actions repo secrets, not here) ---
# VITE_CLERK_PUBLISHABLE_KEY — inlined into the web app at build time.
# DOCKERHUB_USERNAME / DOCKERHUB_TOKEN — for the CI pipeline to push images.
